{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "Whenever you die you lose a heart, if you lose all of them you will be forced to go into spectator mode. With the gamerule minHearts you can set a minimum amount of hearts instead.",
	"authors": [
		"Pete MC Mods, mcmods.pete@gmail.com",
        "Mars (author of original version)"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/hardcore-lite",
		"sources": "https://github.com/MC-Mods-Pete/HardcoreLite",
		"issues": "https://github.com/MC-Mods-Pete/HardcoreLite/issues"
	},
	"license": "All rights reserved",
	"icon": "assets/hardcorelite/hardcorelite.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.petemc.hardcorelite.HardcoreLite"
		]
	},
	"mixins": [
		"hardcorelite.mixins.json"
	],
  "accessWidener" : "hardcorelite.accesswidener",
	"depends": {
		"fabricloader": "${fabric_version_range}",
		"minecraft": "${mc_version_range}",
		"java": "${java_version_range}",
		"fabric-api": "*"
	}
}